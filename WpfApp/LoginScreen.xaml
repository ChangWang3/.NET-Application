<Window x:Class="WpfApp.LoginScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="Login" Height="300" Width="300">
    <StackPanel Margin="20,0,20,0">
        <Label Content="Login" HorizontalAlignment="Center" FontSize="25" Margin="0,10,0,10" />
        <Separator></Separator>
        <Label Content="Username"/>
        <TextBox Name="txtUsername" FontSize="18"/>
        <Label Content="Password"/>
        <PasswordBox Name="txtPassword" FontSize="18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Name="btnSubmit" Content="Submit" Margin="0,0,20,0" Height="30" Width="60" Click="btnSubmit_Click"/>
            <Button Name="btnCancel" Content="Cancel" Height="30" Width="60" Click="btnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
