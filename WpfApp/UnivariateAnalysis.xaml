<Window x:Class="WpfApp.UnivariateAnalysis"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="UnivariateAnalysis" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <Label Content="Enter data set"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>
            <TextBox Name="txtData" 
                     PreviewTextInput="txtData_PreviewTextInput" 
                     TextWrapping="Wrap" 
                     AcceptsReturn="True" 
                     Height="160"
                     MaxWidth="200"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <RadioButton Name="RadioPopulationStd" Content="Population" IsChecked="True"/>
                <RadioButton Name="RadioSampleStd" Content="Sample" Margin="20,0,0,0"/>
            </StackPanel>
            <Button Name="Calculate" 
                    Content="Calculate" 
                    Click="Calculate_Click" 
                    Width="80" 
                    Height="30" 
                    HorizontalAlignment="Left" 
                    Margin="0,10,0,0"/>
            <Button Name="ReturnBtn" 
                    Content="Return" 
                    Width="80" 
                    Height="30" 
                    Margin="0,25,0,0" 
                    Click="ReturnBtn_Click" 
                    HorizontalAlignment="Left"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <Label Content="Summary"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>
            <TextBox Name="txtResult"
                     IsReadOnly="True"
                     TextWrapping="Wrap"/>
        </StackPanel>
        <ScottPlot:WpfPlot Name="BoxAndWhiskersPlot" Grid.Column="2"/>
        <ScottPlot:WpfPlot Name="HistogramPlot" Grid.Column="3"/>
        
    </Grid>

</Window>
