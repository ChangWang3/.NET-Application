        <Button Name="ReturnBtn" Content="Return to Main" Width="100" Height="30" Margin="0,20,20,0" Click="ReturnBtn_Click"/>
        <TextBox Name="txtNumbers" PreviewTextInput="txtNumbers_PreviewTextInput" Margin="-556,107,424,-191" TextWrapping="Wrap"/>
