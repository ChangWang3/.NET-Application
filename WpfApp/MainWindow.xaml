<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statistics Calculator" Width="900" Height="700"
        MinWidth="560" MinHeight="480" WindowStartupLocation="CenterScreen"
        Background="#F4F6FA" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="960">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Statistics Calculator" FontSize="28" FontWeight="SemiBold"
                               Foreground="#172B4D" TextWrapping="Wrap"/>
                    <TextBlock Text="Explore your data, calculate probabilities and check numbers."
                               Foreground="#52627A" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Name="LogoutBtn" Content="Logout" Click="LogoutBtn_Click" Margin="0,0,8,0"/>
                    <Button Name="ExitBtn" Content="Exit" Click="ExitBtn_Click"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Choose a tool" FontSize="20" FontWeight="SemiBold" Foreground="#172B4D"/>
            <UniformGrid Columns="2" Margin="-6,8,-6,16">
                <Border Background="White" BorderBrush="#D8E0EC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6">
                    <StackPanel>
                        <TextBlock Text="Understand one dataset" Foreground="#52627A" TextWrapping="Wrap" MinHeight="42"/>
                        <Button Name="UnivariateBtn" Click="UnivariateBtn_Click" Margin="0,8,0,0">
                            <TextBlock Text="Descriptive Statistics" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#D8E0EC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6">
                    <StackPanel>
                        <TextBlock Text="Explore relationships between two variables" Foreground="#52627A" TextWrapping="Wrap" MinHeight="42"/>
                        <Button Name="BivariateBtn" Click="BivariateBtn_Click" Margin="0,8,0,0">
                            <TextBlock Text="Correlation and Regression" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#B8CBE6" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6">
                    <StackPanel>
                        <TextBlock Text="Calculate outcomes and see their distribution" Foreground="#52627A" TextWrapping="Wrap" MinHeight="42"/>
                        <Button Name="ProbabilityBtn" Click="ProbabilityBtn_Click" Margin="0,8,0,0">
                            <TextBlock Text="Binomial Probability" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#B8CBE6" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6">
                    <StackPanel>
                        <TextBlock Text="Import, preview and export a column of numbers" Foreground="#52627A" TextWrapping="Wrap" MinHeight="42"/>
                        <Button Name="CsvWorkspaceBtn" Click="CsvWorkspaceBtn_Click" Margin="0,8,0,0">
                            <TextBlock Text="CSV Workspace" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="#EAF1FB" BorderBrush="#B8CBE6" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock Text="Quick calculator" FontSize="20" FontWeight="SemiBold" Foreground="#172B4D"/>
                    <TextBlock Text="Enter two numbers using a decimal point, then choose an operation."
                               Foreground="#52627A" TextWrapping="Wrap" Margin="0,6,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="First number" Margin="0,0,0,6"/>
                        <TextBlock Grid.Column="1" Text="Operation" Margin="8,0,0,6"/>
                        <TextBlock Grid.Column="2" Text="Second number" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="1" x:Name="FirstNumberTextBox" Text="2" AutomationProperties.Name="First number"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="OperationComboBox" SelectedIndex="0"
                                  Margin="8,0" Padding="4" VerticalContentAlignment="Center" AutomationProperties.Name="Arithmetic operation">
                            <ComboBoxItem Content="+"/>
                            <ComboBoxItem Content="−"/>
                            <ComboBoxItem Content="×"/>
                            <ComboBoxItem Content="÷"/>
                        </ComboBox>
                        <TextBox Grid.Row="1" Grid.Column="2" x:Name="SecondNumberTextBox" Text="3" AutomationProperties.Name="Second number"/>
                    </Grid>
                    <Button Content="Calculate" Click="QuickCalculate_Click" HorizontalAlignment="Left" Margin="0,14,0,10"/>
                    <TextBlock x:Name="QuickResultText" FontSize="18" Foreground="#172B4D" TextWrapping="Wrap"
                               AutomationProperties.Name="Quick calculator result"/>
                    <TextBlock x:Name="QuickErrorText" Foreground="#B42318" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
